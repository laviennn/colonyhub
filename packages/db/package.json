{
  "name": "@colonyhub/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./menus": "./src/menus.ts"
  },
  "scripts": {
