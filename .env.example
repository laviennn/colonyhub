# =============================================================================
# colonyhub environment variables
# Copy to .env.local for local development, or configure per project in Vercel.
# Note: GA4, GTM, and Meta Pixel IDs are managed dynamically in Command Center
# (/tracking) and stored in the database, so no tracking env vars are needed.
# Production canonical origin (https://colonyhub.id) is locked in packages/content.
# =============================================================================

# --- Shared: required with identical values in both apps/web and apps/command-center ---

# Postgres connection string (Neon, Supabase, or local Postgres).
# If left empty in local dev, @colonyhub/db falls back to a local JSON store (.colonyhub-local-data.json).
DATABASE_URL=

# Shared secrets for on-demand revalidation and time-limited draft previews.
# Generate strong random strings in production (e.g. `openssl rand -hex 32`).
REVALIDATION_SECRET=dev-revalidation-secret-change-in-prod
PREVIEW_SECRET=dev-preview-secret-change-in-prod

# --- Command Center only (apps/command-center) ---

# Target public website origin used for private preview links and cache revalidation.
# Local dev: http://localhost:3000 | Production: https://colonyhub.id
PUBLIC_WEB_URL=http://localhost:3000

# --- Optional overrides ---

# Optional override for the mobile floating WhatsApp button in apps/web (digits only).
# Default verified number in packages/content is 6289675293838 (+62 896-7529-3838).
# NEXT_PUBLIC_WHATSAPP_NUMBER=6289675293838

# Optional custom path for the local JSON fallback file when DATABASE_URL is unset.
# COLONYHUB_LOCAL_DB_PATH=.colonyhub-local-data.json
